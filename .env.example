# =================================================================
# KotiScout - Environment Variables
# =================================================================

# Server configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database Configuration (PostgreSQL / Supabase or local SQLite/PGLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kotiscout

# Supabase Auth Configuration (Server & Client Safe distinction)
# Browser Safe:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_URL=http://localhost:3000

# Server Only (NEVER expose to frontend):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Scheduler / Webhook Secret for Protected Endpoint POST /internal/jobs/run-scheduled-searches
CRON_SECRET=koti_scout_secret_cron_token_change_in_prod

# Default Settings
DEFAULT_TIMEZONE=Europe/Helsinki
DEFAULT_CURRENCY=EUR
