# ─────────────────────────────────────────────────────────────
# 🌲 KotiScout Environment Configuration
# ─────────────────────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Application URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# Property Provider ("etuovi" | "mock" | "authorized")
PROPERTY_PROVIDER=etuovi

# Database Mode ("memory" | "supabase" | "postgres")
# Leave empty for zero-friction in-memory mode
DATABASE_MODE=memory
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ─────────────────────────────────────────────────────────────
# 📬 E-mail & Radar Notification Settings (Resend or SMTP)
# ─────────────────────────────────────────────────────────────
# Recipient for Lina's automated radar alerts
NOTIFICATION_EMAIL_TO=lina@kotiscout.fi
NOTIFICATION_EMAIL_FROM=KotiScout Radar <radar@kotiscout.fi>

# Option A: Resend API Key (Recommended for Vercel/Cloud)
# Get a free key at https://resend.com
RESEND_API_KEY=

# Option B: Standard SMTP (Gmail, Outlook, Custom)
# Leave empty if using Resend or local simulation mode
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
